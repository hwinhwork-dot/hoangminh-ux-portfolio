# ---------------------------------------------------------------------------
# hoangminh-ux-portfolio — environment template
# Copy to .env for local dev.  In production these live in Vercel > Settings >
# Environment Variables.  NEVER commit the filled-in version.
# ---------------------------------------------------------------------------

# --- LLM provider: OpenAI ---------------------------------------------------
# The agent degrades gracefully: with no key set, /api/chat answers from the
# offline knowledge base only (same behaviour as the current static studio).
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.1

# Cheap tier for Hana's triage node (classification only, JSON out).
LLM_TRIAGE_MODEL=gpt-4.1-nano

# --- embeddings for the RAG index (Day-7/8 pipeline) ------------------------
EMBEDDING_PROVIDER=openai          # openai | local
EMBEDDING_MODEL=text-embedding-3-small

# --- retrieval --------------------------------------------------------------
RAG_TOP_K=12                      # candidates from hybrid search
RAG_RERANK_TOP_N=4                # chunks that actually reach the prompt
RAG_MIN_SCORE=0.20                # below this -> "I don't have that indexed"

# --- guardrails -------------------------------------------------------------
MAX_INPUT_CHARS=300               # mirrors the input maxlength in index.html
RATE_LIMIT_PER_MIN=8              # per IP, sliding window
RATE_LIMIT_PER_DAY=60             # per IP
DAILY_TOKEN_BUDGET=200000         # hard stop -> fallback mode for the rest of the day

# --- observability (Day-10) -------------------------------------------------
LOG_LEVEL=INFO
TRACE_SINK=stdout                 # stdout | file | http
TRACE_HTTP_ENDPOINT=

# --- lead capture (optional) ------------------------------------------------
# When an HR user asks to get in touch, the agent can log the request.
LEAD_WEBHOOK_URL=
OWNER_EMAIL=hwinh.work@gmail.com

# --- app --------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,https://hoangminh-ux-portfolio.vercel.app
ENV=development
