*.pem

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- built artifacts ---
# knowledge/index/index.json is deliberately COMMITTED. It is generated by
# `python scripts/ingest_kb.py`, but Vercel builds from the repository and has no build
# step that could regenerate it — so the deployed function only has a knowledge base if
# the artifact ships with the code. Committing it also makes a stale index visible in
# review: the diff shows exactly which chunks changed.
# The ingest gates fail if it drifts from knowledge/raw.

# --- logs & traces (local only; production traces go to the log sink) ---
logs/
*.log

# --- vercel / node ---
.vercel/
node_modules/

# --- os ---
.DS_Store
Thumbs.db
